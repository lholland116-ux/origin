OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4

# Development-only browser/test persona; restart the development server after changing.
CAPA_DEVELOPMENT_ROLE_ID=CAPA_OWNER

# Optional development-only shared organization for multi-user authorization and segregation tests.
# When set, use a canonical UUID; when unset, development maps organization_id to the authenticated user.
# Never use this as a production tenant selector.
CAPA_DEVELOPMENT_ORGANIZATION_ID=
